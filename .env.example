# Public canonical origin, used by sitemap/robots metadata.
NEXT_PUBLIC_SITE_URL=

# Neon Postgres connection string.
DATABASE_URL=

# Auth.js GitHub OAuth. The configured username is the only account allowed in.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_ALLOWED_USERNAME=

# Upstash Redis REST credentials for API rate limits and the optional view count.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend. CONTACT_EMAIL is read only by the server contact handler.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=

# Optional GitHub GraphQL token for the later live activity phase.
GITHUB_TOKEN=
